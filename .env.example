# Copy to .env and fill in. NEVER commit .env.

# --- Database (local PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/finrag

# --- LLM (answers) ---
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# --- Embeddings ---
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=50
EMBEDDING_TOKENS_PER_MINUTE=25000

# --- Vector index (Qdrant embedded; set QDRANT_URL to use a server instead) ---
QDRANT_PATH=./qdrant_data
QDRANT_URL=

# --- Uploads ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# --- App ---
LOG_LEVEL=INFO
